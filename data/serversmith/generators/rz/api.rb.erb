# frozen_string_literal: true

# GET <%= resource_name %>
class <%= resource_name.to_s.camelize %>Api < Grape::API
  resource :<%= resource_name %> do

    desc 'GET <%= resource_name %>'
    params do
      requires :id, type: String, desc: '<%= resource_name.to_s.camelize %> ID.'
    end
    get ':id' do
      obj = <%= resource_name.to_s.camelize %>.find(params[:id])

      <% if resource_info.flags[:deletable] %>
      if obj.deleted_at != nil
        status 404
        { error: :not_found }
      else
        { result: obj }
      end
      <% else %>
      { result: obj }
      <% end %>

    rescue ActiveRecord::RecordNotFound
      status 404
      { error: :not_found }
    end

    desc 'GET <%= resource_name %> listing'
    params do
      optional :page, type: Integer, default: 1, desc: 'Page number'
      optional :limit, type: Integer, default: 20, desc: 'Number of <%= resource_name.to_s.pluralize %> returned per page'
    end
    get do
      query = <%= resource_name.to_s.camelize %>
      <% if resource_info.flags[:deletable] %>
      query = query.where(deleted_at: nil)
      <% end %>
      res = query.offset(params[:page] - 1).limit(params[:per_page])

      { result: res }
    end

  <% if !resource_info.flags[:readonly] %>

    desc 'POST <%= resource_name %>'
    params do
    <% resource_info.fields.each do |field_name, field_info| %>
      <% if field_info.dbtype.to_s.start_with?("userdef_") %>
      <% tablename = field_info.dbtype.to_s[8..] %>
      # <%= field_info.dbname %> <%= field_info.dbtype %>
      requires :<%= field_info.dbname %>_id, type: :string, desc: 'ID of a <%= tablename.to_s.camelize %>'
      <% else %>
      # <%= field_info.dbname %> <%= field_info.dbtype %>
      requires :<%= field_info.dbname %>, type: <%= field_info.grape_param_type %>, desc: '<%= resource_name.to_s.camelize %> <%= field_info.dbname %>'
      <% end %>

    <% end %>
    end
    post do
      obj = <%= resource_name.to_s.camelize %>.create!(params)

      <% if resource_info.info[:ghost_rate_limit] %>
      # IF GHOST RATE LIMIT

      cur_msepoch = (Time.now.to_f * 1000).to_i

      # find out if the player's last request was less than <%= resource_info.info[:ghost_rate_limit][:amount] %>ms ago
      prv_msepoch = Rails.cache.fetch(params[:<%= resource_info.info[:ghost_rate_limit][:keyname] %>])
      Rails.cache.write(params[:<%= resource_info.info[:ghost_rate_limit][:keyname] %>], cur_msepoch)

      if prv_msepoch.nil? || cur_msepoch - prv_msepoch > <%= resource_info.info[:ghost_rate_limit][:amount] %>
        <%= resource_name.to_s.camelize %>CreateTriggerJob.perform_later(obj.id)
      end

      <% else %>
      # IF NOT RATE LIMITED

      <%= resource_name.to_s.camelize %>CreateTriggerJob.perform_later(obj.id)

      <% end %>

      { result: obj }
    end

    <% if resource_info.flags[:deletable] %>
    desc 'DELETE <%= resource_name %>'
    params do
      requires :id, type: String, desc: '<%= resource_name.to_s.camelize %> ID.'
    end
    delete ':id' do
      obj = <%= resource_name.to_s.camelize %>.find(params[:id])

      if obj.deleted_at != nil
        status 404
        { error: :not_found }
      else
        obj.deleted_at = Time.now
        obj.save!
        { result: :ok }
      end

    rescue ActiveRecord::RecordNotFound
      status 404
      { error: :not_found }
    end
    <% end %>

  <% end # if !resource_info.flags[:readonly] %>

  end
end
