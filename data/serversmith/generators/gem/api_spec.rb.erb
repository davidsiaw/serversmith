# frozen_string_literal: true

RSpec.describe <%= dsl.props[:package_name].camelize %>::<%= resource_name.to_s.camelize %> do
  it 'can be initialized' do
  	obj = described_class.new
  end

  it 'fields are populable' do
  	obj = described_class.new

  <% resource_info.fields.each_with_index do |(field_name, field_info), i| %>
    <% if field_info.dbtype.to_s.start_with?("userdef_") %>
    <% tablename = field_info.dbtype.to_s[8..] %>
    obj.<%= field_info.dbname %> = 'UUID'
    <% else %>
    obj.<%= field_info.dbname %> = <%= field_info.examples.first.inspect %>
    <% end %>
  <% end %>
  end



end
