class RailsZen
  def initialize
    if !Dir.exist?('.rz')
      puts "setting up rz"
      reset!
    end
  end

  def reset!(ssf)
    `rm -rf .rz`
    `git clone https://github.com/davidsiaw/rails-zen .rz`

    `rm -rf .gem`
    `git clone https://github.com/davidsiaw/gem-base .gem`

    `rm -rf .fe`
    `chino create serversmith_frontend`
    `mv serversmith_frontend .fe`
  end

  def start!(ssf)
    `cd .rz && `
  end

  def apply!(ssf)
    rz = RzCodeGen.new(ssf)
    rz.generate.each do |filename, info|
      File.write("#{filename}", info[:content])
    end
  end
end




