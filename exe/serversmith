class RzCodeGen
  attr_reader :dsl
  def initialize(ssdsl)
    @dsl = ssdsl
  end

  def generator_for(file, subsys)
    base_data_dir = File.join(Gem.loaded_specs['serversmith'].full_gem_path, 'data', 'serversmith', 'generators', subsys)
    template = File.join(base_data_dir, file)
    Erubis::Eruby.new(File.read(template), filename: template)
  end

  def generate_resources
    result = {}
    dsl.resources.each_with_index do |(resource_name, resource_info), idx|

      inf = {
        dsl: dsl,
        resource_name: resource_name,
        resource_info: resource_info
      }

      generator = generator_for('api.rb.erb', 'rz')

      result[".rz/app/apis/v1_api/#{resource_name}_api.rb"] = {
        content: generator.result(inf)
      }

      generator = generator_for('db.rb.erb', 'rz')

      result[".rz/db/migrate/30000101#{idx.to_s.rjust(6,'0')}_create_#{resource_name}.rb"] = {
        content: generator.result(inf)
      }

      generator = generator_for('model.rb.erb', 'rz')

      result[".rz/app/models/#{resource_name}.rb"] = {
        content: generator.result(inf)
      }

      generator = generator_for('job.rb.erb', 'rz')

      result[".rz/app/jobs/#{resource_name}_create_trigger_job.rb"] = {
        content: generator.result(inf)
      }

      generator = generator_for('api.rb.erb', 'gem')

      result[".gem/lib/#{dsl.props[:package_name]}/#{resource_name}.rb"] = {
        content: generator.result(inf)
      }

      generator = generator_for('api_spec.rb.erb', 'gem')

      result[".gem/spec/#{resource_name}_spec.rb"] = {
        content: generator.result(inf)
      }
    end
    result
  end

  def generate_root
    result = {}

    apilist = []

    dsl.resources.each do |resource_name, _|
      apilist << "    mount #{resource_name.to_s.camelize}Api"
    end

    generator = generator_for('main_api.rb.erb', 'rz')

    result[".rz/app/apis/main_api.rb"] = {
      content: generator.result({dsl: dsl})
    }

    `rm -rf .gem/lib/base`
    `rm -rf .gem/lib/base.rb`
    `rm -rf .gem/spec/base_spec.rb`
    `rm -rf .gem/*.gemspec`

    generator = generator_for('gemspec.rb.erb', 'gem')

    result[".gem/#{dsl.props[:package_name]}.gemspec"] = {
      content: generator.result({dsl: dsl})
    }

    `mkdir -p .gem/lib/#{dsl.props[:package_name]}`

    generator = generator_for('version.rb.erb', 'gem')

    result[".gem/lib/#{dsl.props[:package_name]}/version.rb"] = {
      content: generator.result({dsl: dsl})
    }

    generator = generator_for('base.rb.erb', 'gem')

    result[".gem/lib/#{dsl.props[:package_name]}.rb"] = {
      content: generator.result({dsl: dsl})
    }

    generator = generator_for('base_spec.rb.erb', 'gem')

    result[".gem/spec/#{dsl.props[:package_name]}_spec.rb"] = {
      content: generator.result({dsl: dsl})
    }

    generator = generator_for('client_spec.rb.erb', 'gem')

    result[".gem/spec/client_spec.rb"] = {
      content: generator.result({dsl: dsl})
    }

    generator = generator_for('spec_helper.rb.erb', 'gem')

    result[".gem/spec/spec_helper.rb"] = {
      content: generator.result({dsl: dsl})
    }

    generator = generator_for('README.md.erb', 'gem')

    result[".gem/README.md"] = {
      content: generator.result({dsl: dsl})
    }

    generator = generator_for('executable.erb', 'gem')

    result[".gem/exe/#{dsl.props[:package_name]}"] = {
      content: generator.result({dsl: dsl})
    }


    result
  end

  def generate
    result = {}

    generate_resources.each {|k,v| result[k]=v}
    generate_root.each {|k,v| result[k]=v}

    result
  end

end

