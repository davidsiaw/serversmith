class FieldDsl
  attr_reader :examples
  
  def initialize(name, type)
    @name = name
    @type = type
    @examples = []
  end

  def dbtype
    if @type == :string
      :string
    elsif @type == :integer
      :integer
    else
      :"userdef_#{@type}"
    end
  end

  def dbname
    @name
  end

end

class ResourceDsl
  attr_reader :fields, :flags, :triggers
  def initialize
    @fields = {}
    @flags = {
      deletable: false
    }
    @triggers = {}
  end

  def field(name, type, &block)
    raise "field name cannot start with underscore" if name.start_with?('_')
    name = name.to_s
    raise "Field #{name} already exist" if @fields.key?(name)

    f = FieldDsl.new(name, type)
    f.instance_eval(&block) if block
    @fields[name] = f
  end

  def example(name, exval)
    @fields[name.to_s].examples << exval
  end

  def set(flag)
    @flags[flag] = true
  end

  def on_create(&block)
    @triggers[:create] = {
      source: block.source.to_s.sub('on_create', 'blk = Proc.new')
    }
  end
end

class ServersmithFileDsl
  attr_reader :resources, :props
  def initialize
    @props = {
      package_name: 'base',
      package_authors: ['David Siaw'],
      package_emails: ['874280+davidsiaw@users.noreply.github.com'],
      package_homepage: 'https://github.com/davidsiaw/gem-base',
      package_license: 'MIT'
    }
    @resources = {}
  end

  def package_name(name)
    @props[:package_name] = name.to_s
  end

  def package_name_camelcase
    @props[:package_name].camelcase
  end

  def resource(name, &block)
    name = name.to_s
    raise "resource #{name} already exist" if @resources.key?(name)

    r = ResourceDsl.new
    r.instance_eval(&block)
    @resources[name] = r
  end
end

