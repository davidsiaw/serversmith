class RailsZen
  def initialize
    if !Dir.exist?('.rz')
      puts "setting up rz"
      reset!
    end
  end

  def reset!
    `rm -rf .rz`
    `git clone https://github.com/davidsiaw/rails-zen .rz`
  end

  def start!
    `cd .rz && `
  end

  def apply(ssf)
    rz = RzCodeGen.new(ssf)
    rz.generate.each do |filename, info|
      File.write(".rz/#{filename}", info[:content])
    end
  end
end

rz = RailsZen.new
rz.reset!
rz.apply(ssf)
